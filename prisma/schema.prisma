generator client {
  provider = "prisma-client-js"
}

// Neon: DATABASE_URL is the pooled connection string, DIRECT_URL the direct one (used by prisma db push / migrate).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  SCHOOL
}

enum Status {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  role         Role        @default(STUDENT)
  fullName     String
  studentId    String?     @unique
  rollNo       String?
  school       String?
  createdAt    DateTime    @default(now())
  documents    Document[]
  shares       Share[]
  accessLog    AccessLog[]
}

model Document {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  docType   String
  fileName  String
  mime      String
  sha256    String
  blobUrl   String
  blobPath  String
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Share {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  codeHash  String
  docIds    String[]
  expiresAt DateTime

  @@index([ownerId, codeHash])
}

model AccessLog {
  id      Int      @id @default(autoincrement())
  ownerId String
  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ok      Boolean
  at      DateTime @default(now())

  @@index([ownerId, at])
}
